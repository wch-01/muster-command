# Copy this file to .env and replace every replace_* value.
# For named environments, copy it to .env.dev or .env.prod and run:
# docker compose --env-file .env.dev up -d
# docker compose --env-file .env.prod up -d

# Required Discord application settings.
DISCORD_BOT_TOKEN=replace_with_discord_bot_token
APPLICATION_ID=replace_with_discord_application_id
DISCORD_CLIENT_SECRET=replace_with_discord_oauth_client_secret
ADMIN_DISCORD_USER_IDS=replace_with_comma_separated_discord_user_ids

# Runtime mode: development or production.
STATE=development

# PostgreSQL connection used when running the application on the host.
# Docker Compose overrides this hostname for the bot container.
DATABASE_URL=postgresql://bot:replace_with_database_password@localhost:5432/starbot?schema=public
POSTGRES_PASSWORD=replace_with_database_password
POSTGRES_PORT=5432

# Optional runtime settings.
BOT_TIMEZONE=UTC
SETUP_HOST=127.0.0.1
SETUP_PORT=3000
SETTINGS_FILE=./data/settings.json
ADMIN_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Optional aliases accepted by the application:
# DISCORD_TOKEN may be used instead of DISCORD_BOT_TOKEN.
# DISCORD_CLIENT_ID may be used instead of APPLICATION_ID.
